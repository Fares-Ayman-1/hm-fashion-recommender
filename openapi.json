{
  "openapi": "3.1.0",
  "info": {
    "title": "H&M Fashion Recommender API",
    "description": "Top-12 personalised recommendations for 1.37M H&M customers, with the reason behind each item. Read-only. Errors always use `{\"error\": {\"code\", \"message\", \"details\"}}`.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness check",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/model": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Model version and validation scores",
        "operationId": "model_info_v1_model_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfo"
                }
              }
            }
          }
        }
      }
    },
    "/v1/customers": {
      "get": {
        "tags": [
          "customers"
        ],
        "summary": "List demo customers (those with purchase history served)",
        "operationId": "list_customers_v1_customers_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerPage"
                }
              }
            }
          },
          "404": {
            "description": "`customer_not_found`, `article_not_found`, `history_not_available`, `image_not_available`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`validation_error` or `unknown_query_parameter`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/customers/{customer_id}/recommendations": {
      "get": {
        "tags": [
          "customers"
        ],
        "summary": "Personalised top-k",
        "operationId": "recommendations_v1_customers__customer_id__recommendations_get",
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Customer Id"
            }
          },
          {
            "name": "k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 12,
              "minimum": 1,
              "default": 12,
              "title": "K"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "404": {
            "description": "`customer_not_found`, `article_not_found`, `history_not_available`, `image_not_available`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`validation_error` or `unknown_query_parameter`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/customers/{customer_id}/purchases": {
      "get": {
        "tags": [
          "customers"
        ],
        "summary": "Recent purchases (demo customers)",
        "operationId": "purchases_v1_customers__customer_id__purchases_get",
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Customer Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchasesResponse"
                }
              }
            }
          },
          "404": {
            "description": "`customer_not_found`, `article_not_found`, `history_not_available`, `image_not_available`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`validation_error` or `unknown_query_parameter`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/articles/{article_id}": {
      "get": {
        "tags": [
          "articles"
        ],
        "summary": "Article details",
        "operationId": "article_v1_articles__article_id__get",
        "parameters": [
          {
            "name": "article_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Article Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            }
          },
          "404": {
            "description": "`customer_not_found`, `article_not_found`, `history_not_available`, `image_not_available`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`validation_error` or `unknown_query_parameter`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/articles/{article_id}/similar": {
      "get": {
        "tags": [
          "articles"
        ],
        "summary": "Most similar articles (CLIP)",
        "operationId": "similar_v1_articles__article_id__similar_get",
        "parameters": [
          {
            "name": "article_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Article Id"
            }
          },
          {
            "name": "k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 12,
              "minimum": 1,
              "default": 6,
              "title": "K"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarResponse"
                }
              }
            }
          },
          "404": {
            "description": "`customer_not_found`, `article_not_found`, `history_not_available`, `image_not_available`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`validation_error` or `unknown_query_parameter`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/articles/{article_id}/image": {
      "get": {
        "tags": [
          "articles"
        ],
        "summary": "Article thumbnail (JPEG)",
        "operationId": "image_v1_articles__article_id__image_get",
        "parameters": [
          {
            "name": "article_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Article Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "404": {
            "description": "`customer_not_found`, `article_not_found`, `history_not_available`, `image_not_available`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Article": {
        "properties": {
          "article_id": {
            "type": "integer",
            "title": "Article Id",
            "examples": [
              706016001
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "product_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Type"
          },
          "colour": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Colour"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url",
            "description": "Thumbnail URL, or null when no photo is available"
          }
        },
        "type": "object",
        "required": [
          "article_id",
          "name",
          "product_type",
          "colour",
          "section",
          "image_url"
        ],
        "title": "Article"
      },
      "CustomerPage": {
        "properties": {
          "data": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Data"
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "type": "object",
        "required": [
          "data",
          "pagination"
        ],
        "title": "CustomerPage"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "customer_not_found"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelInfo": {
        "properties": {
          "api_version": {
            "type": "string",
            "title": "Api Version"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "trained_at": {
            "type": "string",
            "title": "Trained At"
          },
          "k": {
            "type": "integer",
            "title": "K"
          },
          "validation_week": {
            "type": "integer",
            "title": "Validation Week"
          },
          "map12": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Map12",
            "description": "MAP@12 on the validation week per model (higher is better)"
          },
          "candidate_recall": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Candidate Recall"
          },
          "mlflow_run_ids": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Mlflow Run Ids"
          }
        },
        "type": "object",
        "required": [
          "api_version",
          "model",
          "trained_at",
          "k",
          "validation_week",
          "map12",
          "candidate_recall",
          "mlflow_run_ids"
        ],
        "title": "ModelInfo"
      },
      "Pagination": {
        "properties": {
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "limit",
          "offset",
          "total"
        ],
        "title": "Pagination"
      },
      "Purchase": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "article": {
            "$ref": "#/components/schemas/Article"
          }
        },
        "type": "object",
        "required": [
          "date",
          "article"
        ],
        "title": "Purchase"
      },
      "PurchasesResponse": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/Purchase"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "data"
        ],
        "title": "PurchasesResponse"
      },
      "Recommendation": {
        "properties": {
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "article": {
            "$ref": "#/components/schemas/Article"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons",
            "examples": [
              [
                "repurchase",
                "cooccur"
              ]
            ]
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "rank",
          "article",
          "reasons",
          "explanation"
        ],
        "title": "Recommendation"
      },
      "RecommendationResponse": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "data"
        ],
        "title": "RecommendationResponse"
      },
      "SimilarItem": {
        "properties": {
          "article": {
            "$ref": "#/components/schemas/Article"
          },
          "similarity": {
            "type": "number",
            "title": "Similarity"
          }
        },
        "type": "object",
        "required": [
          "article",
          "similarity"
        ],
        "title": "SimilarItem"
      },
      "SimilarResponse": {
        "properties": {
          "article_id": {
            "type": "integer",
            "title": "Article Id"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/SimilarItem"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "article_id",
          "data"
        ],
        "title": "SimilarResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}